# =============================================================
#  Patient-Aware Cyber-Resilience - example environment file
#  Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# ---- Application ----
APP_NAME="Patient-Aware Cyber-Resilience"
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---- Security / auth ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=change-me-use-a-long-random-value
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_ENABLED=true
# Bootstrap SOC operator. Password is hashed at startup; rotate immediately.
BOOTSTRAP_ANALYST_USERNAME=soc_analyst
BOOTSTRAP_ANALYST_PASSWORD=change-me-before-first-run
BOOTSTRAP_APPROVER_USERNAME=clinical_approver
BOOTSTRAP_APPROVER_PASSWORD=change-me-before-first-run

# ---- Database ----
# PostgreSQL in Docker Compose; SQLite fallback for local dev/CI.
DATABASE_URL=postgresql+psycopg://pacr:change-me@localhost:5432/pacr
# DATABASE_URL=sqlite+pysqlite:///./data/local/pacr.db
DATABASE_ECHO=false
POSTGRES_USER=pacr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pacr

# ---- IoMT simulator ----
SIM_RANDOM_SEED=20260101
SIM_TICK_INTERVAL_SECONDS=1.0
SIM_AUTOSTART=false

# ---- Detection engine ----
DETECTION_MODEL_PATH=artifacts/detection/current
DETECTION_DECISION_THRESHOLD=0.5
DETECTION_ANOMALY_CONTAMINATION=0.05

# ---- Agentic AI ----
# deterministic = offline rule-based provider (no API key, reproducible).
# anthropic / openai = real LLM providers (require a key below).
AGENT_LLM_PROVIDER=deterministic
AGENT_LLM_MODEL=claude-sonnet-4-5
AGENT_LLM_TEMPERATURE=0.0
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Risk engine ----
RISK_PROFILE=configs/risk_profile.default.yaml

# ---- Policy / autonomy ----
POLICY_PROFILE=configs/policy.default.yaml
AUTONOMY_ENABLED=true
APPROVAL_TIMEOUT_SECONDS=900

# ---- Blockchain provenance ----
# local = hash-chained append-only ledger (runs anywhere, used by CI)
# fabric = Hyperledger Fabric gateway (requires a running Fabric network)
PROVENANCE_BACKEND=local
PROVENANCE_LOCAL_PATH=data/local/provenance
FABRIC_CHANNEL=pacrchannel
FABRIC_CHAINCODE=provenance
FABRIC_MSP_ID=HospitalMSP
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_GATEWAY_HOST_ALIAS=peer0.hospital.pacr.local
# Paths to identity material - keep OUTSIDE the repository.
FABRIC_CERT_PATH=/secure/fabric/hospital/signcerts/cert.pem
FABRIC_KEY_PATH=/secure/fabric/hospital/keystore/key.pem
FABRIC_TLS_CA_PATH=/secure/fabric/hospital/tls/ca.crt
