# Copy to .env and adjust for your environment. Never commit the real .env file.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (also used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patient_aware_cyber_resilience
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patient_aware_cyber_resilience

# --- Frontend (Phase 10+; also used by docker-compose.yml, Phase 14) ---
# Host port the SOC dashboard is published on, both via `npm run dev` and
# via docker-compose's `frontend` service. Also sets the backend's own
# CORS_ALLOWED_ORIGINS default above and the frontend build's
# VITE_API_BASE_URL default in docker-compose.yml -- change this in one
# place, not three, if you need a different port.
FRONTEND_PORT=5173

# --- Blockchain (Phase 8+, real field names -- `fabric_client_mode`
# defaults to "mock" since most dev/test runs have no live Fabric network
# up; bring up blockchain/network/ first, per its own README, then set this
# to "subprocess" for real on-chain commits) ---
# FABRIC_CLIENT_MODE=subprocess
# FABRIC_NETWORK_SCRIPTS_DIR=../blockchain/network/scripts
# FABRIC_CHAINCODE_NAME=provenance

# --- LLM / Agentic AI (not yet used -- no real LLM backend exists in this
# codebase yet; MockLLMClient stands in everywhere, see app/agents/README.md) ---
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
