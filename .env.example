# Copy to .env and adjust for your environment. Never commit the real .env file.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (also used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patient_aware_cyber_resilience
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patient_aware_cyber_resilience

# Post-Phase-15 addition. "memory" | "postgres" -- which repository
# implementation backs incidents, agent traces, recovery results,
# proposed/executed responses, and the blockchain outbox (see
# backend/app/core/config.py's Settings.repository_backend and
# backend/app/core/db.py for the sync-driver tradeoff "postgres" accepts).
# Defaults to "memory" if unset (safe for local dev with no Postgres
# running); docker-compose.yml sets this to "postgres" directly on the
# backend service since compose guarantees a healthy Postgres dependency.
# REPOSITORY_BACKEND=postgres

# --- Frontend (Phase 10+; also used by docker-compose.yml, Phase 14) ---
# Host port the SOC dashboard is published on, both via `npm run dev` and
# via docker-compose's `frontend` service. Also sets the backend's own
# CORS_ALLOWED_ORIGINS default above and the frontend build's
# VITE_API_BASE_URL default in docker-compose.yml -- change this in one
# place, not three, if you need a different port.
FRONTEND_PORT=5173

# --- Blockchain (Phase 8+, real field names -- `fabric_client_mode`
# defaults to "mock" since most dev/test runs have no live Fabric network
# up; bring up blockchain/network/ first, per its own README, then set this
# to "subprocess" for real on-chain commits) ---
# FABRIC_CLIENT_MODE=subprocess
# FABRIC_NETWORK_SCRIPTS_DIR=../blockchain/network/scripts
# FABRIC_CHAINCODE_NAME=provenance

# --- LLM / Agentic AI (post-Phase-15: a real backend now exists --
# GeminiLLMClient, backend/app/agents/llm_client.py -- selected via
# LLM_BACKEND=gemini below. Defaults to "mock" (MockLLMClient, no real LLM
# call) if unset, so every pre-existing test and the default dev/demo
# experience are unaffected. Get a Gemini API key at
# https://aistudio.google.com/app/apikey ) ---
# LLM_BACKEND=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Request limits (backend/app/core/limits.py). Both default to 0 = off. In-process
# state: with several worker processes each enforces its own window. A
# /detections/score-flows batch of 1000 flows is ~1 MB of JSON. ---
# RATE_LIMIT_PER_MINUTE=120
# MAX_REQUEST_BODY_BYTES=5242880

# --- Real-data detector (POST /detections/score-flows). The artifact is produced by
# `python -m app.cybersecurity.train_ciciomt2024` and is gitignored. ---
# REAL_DETECTOR_MODEL_PATH=../experiments/models/ciciomt2024_xgboost.joblib

# --- Policy Engine confidence gate (opt-in; unset = exactly Section 13's rules). When
# set, an otherwise-autonomous action goes to human approval if the detector's
# confidence is below this value or unknown. Calibrate it on validation data -- see
# evaluation/calibrated_gating.md -- do not guess. ---
# POLICY_MIN_AUTONOMOUS_CONFIDENCE=0.9

# --- Authentication/authorization (post-Phase-15 -- backend/app/core/auth.py.
# Defaults to disabled (AUTH_ENABLED unset/false), matching this app's
# historical no-auth behavior exactly, so every pre-existing test and the
# default dev/demo experience are unaffected. Set AUTH_ENABLED=true plus at
# least one real API_KEYS entry for anything resembling a real deployment --
# enabling auth with no keys configured locks out every route but /health
# (fails closed, not open, deliberately). Format: key:role:identity pairs,
# comma-separated; role is one of viewer | operator | approver.) ---
# AUTH_ENABLED=true
# API_KEYS=changeme-viewer-key:viewer:alice,changeme-approver-key:approver:bob
